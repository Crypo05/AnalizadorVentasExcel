<Window x:Class="AnalizadorVentasExcel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Analizador Corporativo" Height="850" Width="1300"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F4F6F6" BorderBrush="#D0D3D4" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="Panel de Control" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAyuda" DockPanel.Dock="Right" Content="?" Width="26" Height="26"
                            Click="BtnAyuda_Click" Cursor="Hand" FontWeight="Bold" FontSize="15"
                            Background="#2C3E50" Foreground="White" BorderThickness="0"
                            ToolTip="Guía de uso: todas las funciones explicadas y cómo combinarlas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="13"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>

                <GroupBox Grid.Row="1" Header="1. Carga Masiva" Margin="0,0,0,5" BorderBrush="#BDC3C7">
                    <StackPanel Margin="5">
                        <TextBlock Text="Tipo de Negocio:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTipoNegocio" Padding="5" Margin="0,0,0,10" SelectedIndex="0">
                            <ComboBoxItem Content="Detección Automática"/>
                            <ComboBoxItem Content="Minimarket (Detallado)"/>
                            <ComboBoxItem Content="Souvenir (Agrupado)"/>
                        </ComboBox>

                        <Button x:Name="BtnCargarCarpeta" Content="📂 Seleccionar Carpeta" Height="30" Click="BtnCargarCarpeta_Click" Background="#2980B9" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        <ProgressBar x:Name="BarraProgreso" Height="4" Margin="0,4,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2980B9" Background="Transparent" BorderThickness="0"/>
                        <TextBlock x:Name="TxtEstadoArchivo" Text="Listo" FontSize="10" Margin="0,2,0,0" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                        <GroupBox Header="Herramientas Avanzadas" Margin="0,0,0,10" BorderBrush="#BDC3C7">
                            <StackPanel Margin="5">
                                <Button x:Name="BtnAuditar" Content="🔍 Auditar Anomalías" Height="30"
                Click="BtnAuditar_Click" Background="#E67E22" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                                <TextBlock Text="Detecta descripciones diferentes y márgenes bajos." FontSize="9" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <Button x:Name="BtnComparativa" Content="⚖️ Comparativa de Precios" Height="30" Margin="0,8,0,0"
                Click="BtnComparativa_Click" Background="#8E44AD" Foreground="White" FontWeight="Bold" Cursor="Hand"
                ToolTip="Compara los precios de un mismo producto entre dos o más sucursales"/>
                                <TextBlock Text="Otro sistema, con sus propios archivos: listas de precios por sucursal." FontSize="9" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="2. Filtros" Margin="0,0,0,5" BorderBrush="#BDC3C7">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Sucursales:" FontWeight="SemiBold"/>
                                <Button Content="Todas" Click="BtnSelectAllSucursal_Click" DockPanel.Dock="Right" FontSize="9" Padding="2,0"/>
                            </DockPanel>
                            <ListBox x:Name="LstFiltroSucursal" Style="{StaticResource CheckListStyle}"/>

                            <DockPanel LastChildFill="False" Margin="0,5,0,0">
                                <TextBlock Text="Periodos:" FontWeight="SemiBold"/>
                                <Button Content="Todos" Click="BtnSelectAllFecha_Click" DockPanel.Dock="Right" FontSize="9" Padding="2,0"/>
                            </DockPanel>
                            <ListBox x:Name="LstFiltroFecha" Style="{StaticResource CheckListStyle}"/>

                            <DockPanel LastChildFill="False" Margin="0,5,0,0">
                                <TextBlock Text="Proveedores:" FontWeight="SemiBold"/>
                                <Button Content="Ninguno" Click="BtnNingunoProv_Click" DockPanel.Dock="Right" Style="{StaticResource BotonMini}"/>
                                <Button Content="Todos" Click="BtnSelectAllProv_Click" DockPanel.Dock="Right" Style="{StaticResource BotonMini}"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBox x:Name="TxtBuscarProveedor" Padding="3,2" FontSize="11"
                                         TextChanged="TxtBuscarProveedor_TextChanged"
                                         ToolTip="Filtra la lista. No cambia lo que ya está marcado."/>
                                <TextBlock x:Name="PistaProveedor" Text="🔎 Buscar proveedor..." Style="{StaticResource PistaBusqueda}"/>
                            </Grid>
                            <ListBox x:Name="LstFiltroProveedor" Style="{StaticResource CheckListStyle}"/>

                            <DockPanel LastChildFill="False" Margin="0,5,0,0">
                                <TextBlock Text="Familias:" FontWeight="SemiBold"/>
                                <Button Content="Ninguna" Click="BtnNingunaFam_Click" DockPanel.Dock="Right" Style="{StaticResource BotonMini}"/>
                                <Button Content="Todas" Click="BtnSelectAllFam_Click" DockPanel.Dock="Right" Style="{StaticResource BotonMini}"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBox x:Name="TxtBuscarFamilia" Padding="3,2" FontSize="11"
                                         TextChanged="TxtBuscarFamilia_TextChanged"
                                         ToolTip="Filtra la lista. No cambia lo que ya está marcado."/>
                                <TextBlock x:Name="PistaFamilia" Text="🔎 Buscar familia..." Style="{StaticResource PistaBusqueda}"/>
                            </Grid>
                            <ListBox x:Name="LstFiltroFamilia" Style="{StaticResource CheckListStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="3. Gráfico" BorderBrush="#BDC3C7" Margin="0,0,0,5">
                    <StackPanel Margin="5">
                        <TextBlock Text="Eje Principal (X):" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbAgrupacion" SelectionChanged="AplicarFiltros_Event" Padding="4" Margin="0,0,0,5">
                            <ComboBoxItem Content="Año Mes" IsSelected="True"/>
                            <ComboBoxItem Content="Familia"/>
                            <ComboBoxItem Content="Proveedor"/>
                            <ComboBoxItem Content="Sucursal"/>
                            <ComboBoxItem Content="Articulo"/>
                        </ComboBox>

                        <TextBlock Text="Desglose (Series):" FontWeight="SemiBold"/>
                        <ListBox x:Name="LstDesglose" Style="{StaticResource CheckListStyle}" Height="60" Margin="0,0,0,5"/>

                        <TextBlock Text="Operación:" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbOperacion" SelectionChanged="AplicarFiltros_Event" Padding="4">
                            <ComboBoxItem Content="Suma Total (Colones)" IsSelected="True"/>
                           
                            <ComboBoxItem Content="Conteo (Transacciones)"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="4" Margin="5,10,5,0">
                    <Separator Margin="0,0,0,10"/>

                    <TextBlock Text="Desarrollado por:" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock Text="MATEO SANABRIA" FontSize="12" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtVersion" Text="v0.0.0" VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
                        <Button x:Name="BtnActualizar" Grid.Column="1" Content="🔄 Actualizar" Click="BtnActualizar_Click" FontSize="10" Padding="5,2"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="TxtTituloReporte" Text="Bienvenido" FontSize="20" FontWeight="Bold" Foreground="#34495E"/>
                <TextBlock x:Name="TxtSubtitulo" Text="Seleccione una carpeta para iniciar" FontSize="14" Foreground="#7F8C8D"/>
            </StackPanel>

            <DataGrid x:Name="GridResultados" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="1" BorderBrush="#E5E7E9" Padding="5"
                      EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Etiqueta}" Width="2*"/>
                    <DataGridTextColumn Header="Detalle" Binding="{Binding DetalleSecundario}" Width="2*" FontSize="11" Foreground="DimGray"/>

                    <DataGridTextColumn x:Name="ColumnaValor" Header="Venta Total" Binding="{Binding ValorFormateado}" Width="*" FontWeight="Bold"/>

                    <DataGridTextColumn Header="% Utilidad" Binding="{Binding MargenFormateado}" Width="0.8*" FontWeight="SemiBold" Foreground="#27AE60"/>

                    <DataGridTextColumn x:Name="ColumnaParticipacion" Header="% Part." Binding="{Binding Participacion}" Width="1.2*" Foreground="#E74C3C" FontWeight="Medium"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#ECF0F1"/>

            <Border Grid.Row="3" Margin="0,15,0,0" BorderBrush="#E5E7E9" BorderThickness="1" Padding="10" Background="White">
                <lvc:CartesianChart x:Name="GraficoVentas" LegendPosition="Right"/>
            </Border>
        </Grid>
    </Grid>
</Window>