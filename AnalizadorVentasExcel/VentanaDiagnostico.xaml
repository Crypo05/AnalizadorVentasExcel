<Window x:Class="AnalizadorVentasExcel.VentanaDiagnostico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:AnalizadorVentasExcel.Modelos"
        Title="Diagnóstico de carga"
        Height="620" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Diagnóstico de carga" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TxtResumen" FontSize="12" Foreground="#AEB6BF" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="GridDiagnostico" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="1" BorderBrush="#E5E7E9" Padding="5"
                      EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="GridDiagnostico_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding Icono}" Width="34" FontSize="14">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoCarga.Cargado}">
                                        <Setter Property="Foreground" Value="#1E8E3E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoCarga.ConAvisos}">
                                        <Setter Property="Foreground" Value="#B9770E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoCarga.NoCargado}">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Ruta}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Sucursal" Binding="{Binding Sucursal}" Width="1.1*"/>

                    <DataGridTextColumn Header="Filas" Binding="{Binding FilasTexto}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Qué pasó" Binding="{Binding Mensaje}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Qué hacer" Binding="{Binding Sugerencia}" Width="2.5*" Foreground="#21618C">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#ECF0F1"/>

            <Border x:Name="PanelDetalle" Grid.Row="2" Background="#F8F9F9" BorderBrush="#E5E7E9" BorderThickness="1" Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TxtDetalleTitulo" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Seleccioná un archivo para ver el detalle."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaDetalles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#34495E" Margin="0,0,0,3"><Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F4F6F6" BorderBrush="#D0D3D4" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#7F8C8D"
                           Text="Copiá el informe para mandarlo por WhatsApp o correo si necesitás ayuda."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCopiarInforme" Content="📋 Copiar informe" Padding="18,5" Margin="0,0,10,0"
                            Click="BtnCopiarInforme_Click" Background="#16A085" Foreground="White" FontWeight="Bold"
                            Cursor="Hand" BorderThickness="0"/>
                    <Button Content="Cerrar" Padding="18,5" Click="BtnCerrar_Click"
                            Background="#2980B9" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
