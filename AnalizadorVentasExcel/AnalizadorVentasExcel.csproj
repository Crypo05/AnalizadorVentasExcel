<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>

		<Authors>Mateo Sanabria Murcia</Authors>
		<Company>Nomada</Company>
		<Product>Analizador Corporativo</Product>
		<Copyright>© 2026 Mateo Sanabria</Copyright>
		<Description>Análisis de ventas y comparativa de precios entre sucursales.</Description>

		<!-- Fuente única de la versión: de acá salen los metadatos del .exe y también la
		     que muestra la app y compara el actualizador (MainWindow.VersionActual la lee
		     del ensamblado). Al publicar una versión nueva se cambia solo este número,
		     y la etiqueta del release en GitHub tiene que coincidir. -->
		<Version>1.8.1</Version>
		<AssemblyTitle>Analizador Corporativo</AssemblyTitle>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<SelfContained>true</SelfContained>

		<PublishSingleFile>true</PublishSingleFile>

		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ExcelDataReader" Version="3.8.0" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
		<PackageReference Include="SkiaSharp" Version="2.88.6" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.6" />
	</ItemGroup>

</Project>