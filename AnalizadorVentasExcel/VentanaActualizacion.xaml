<Window x:Class="AnalizadorVentasExcel.VentanaActualizacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualización"
        Height="440" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="18,14">
            <StackPanel>
                <TextBlock x:Name="TxtTitulo" Text="Buscando actualizaciones..." FontSize="18"
                           FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtVersiones" FontSize="12" Foreground="#AEB6BF" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="18,14,18,0" BorderBrush="#E5E7E9" BorderThickness="1" Background="#F8F9F9">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <TextBlock x:Name="TxtNotas" TextWrapping="Wrap" FontSize="12.5" Foreground="#34495E" LineHeight="19"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="18,12,18,0">
            <ProgressBar x:Name="BarraDescarga" Height="18" Minimum="0" Maximum="100" Visibility="Collapsed"
                         Foreground="#2980B9"/>
            <TextBlock x:Name="TxtProgreso" FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#F4F6F6" BorderBrush="#D0D3D4" BorderThickness="0,1,0,0"
                Padding="18,12" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnVerEnGitHub" Content="Ver en GitHub" Click="BtnVerEnGitHub_Click"
                        Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" Cursor="Hand"/>
                <Button x:Name="BtnAccion" Content="Actualizar ahora" Click="BtnAccion_Click"
                        Padding="18,6" Margin="0,0,8,0" IsEnabled="False" Cursor="Hand"
                        Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button x:Name="BtnCerrar" Content="Cerrar" Click="BtnCerrar_Click" Padding="18,6" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
